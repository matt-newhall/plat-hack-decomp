{
  "key": 13379,
  "messages": [
    {
      "id": "LakeValorDrained_Text_WhatYouDoWant",
      "en_US": [
        "What do you want?\n",
        "You’re investigating the explosion?\r",
        "Bah, it doesn’t matter who you are.\n",
        "It’s too late to make any difference.\r",
        "Things are going to get really\n",
        "interesting now.\r",
        "All the legendary Pokémon are going\n",
        "to be brought to our HQ in Veilstone!"
      ]
    },
    {
      "id": "LakeValorDrained_Text_MagikarpWorthless",
      "en_US": [
        "Even Team Galactic has no use for\n",
        "MAGIKARP! Worthless, all of them!"
      ]
    },
    {
      "id": "LakeValorDrained_Text_NextStopLakeVerity",
      "en_US": [
        "Hahaha!\n",
        "Next stop, Lake Verity!\r",
        "The closest civilization is that hick\n",
        "town called Twinleaf!\r",
        "We can roll in there completely\n",
        "unopposed!"
      ]
    },
    {
      "id": "LakeValorDrained_Text_MagikarpIsFlopping",
      "en_US": "A MAGIKARP is weakly flopping about..."
    },
    {
      "id": "LakeValorDrained_Text_PaulJoin",
      "en_US": [
        "...You again. Guessing you also\n",
        "heard the loud explosion.\r",
        "Team Galactic drained a whole lake\n",
        "just to grab a Pokémon. Pathetic.\r",
        "I’m going in there. Keep up if you\n",
        "can. Don’t slow me down."
      ]
    },
    {
      "id": "LakeValorDrained_Text_PlayerDecidedToGoWithPaul",
      "en_US": [
        "{STRVAR_1 3, 0, 0} decided to go with\n",
        "Paul!"
      ]
    },
    {
      "id": "LakeValorDrained_Text_PaulStepBack",
      "en_US": [
        "Backing out already?\r",
        "Fine. I’ll wait right here.\n",
        "Come find me when you’re ready."
      ]
    }
  ]
}
