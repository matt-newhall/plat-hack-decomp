{
  "key": 50231,
  "messages": [
    {
      "id": "TurnbackCaveGiratinaRoom_Text_GiratinaCry",
      "en_US": "...Bishaan!\r"
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_GiratinaDisappeared",
      "en_US": "GIRATINA disappeared..."
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_MysteriousPortal",
      "en_US": [
        "A mysterious portal...\r",
        "Hop into it?"
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_PlayerLeaptIntoPortal",
      "en_US": "{STRVAR_1 3, 0, 0} leapt into the portal.\r"
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_PlaceWhereWorldsOverlap",
      "en_US": [
        "This is...\r",
        "That where life sparkles...\n",
        "That where life has faded...\r",
        "A place where two worlds overlap..."
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_CursedBook",
      "en_US": [
        "An old book lies open in the\n",
        "moss...\r",
        "Its pages crawl with symbols\n",
        "that shift as you read.\r",
        "Read on?"
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_CursedBookRead",
      "en_US": [
        "{STRVAR_1 3, 0, 0} reads the\n",
        "final line...\r",
        "Everything goes dark."
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_PortalInert",
      "en_US": [
        "The portal shimmers faintly...\r",
        "But it seems to have lost its pull.\n",
        "Nothing happens."
      ]
    },
    {
      "id": "TurnbackCaveGiratinaRoom_Text_GoToDistortionWorld",
      "en_US": [
        "It’s a portal leading to the\n",
        "Distortion World...\r",
        "Would you like to leap into the portal\n",
        "and go to the Distortion World?"
      ]
    }
  ]
}
